{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/raghav-vk/panini-neuro-symbolic-ai/data/schemas/sandhi-rule.schema.json",
  "title": "Typed external vowel-sandhi rule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "rule_id",
    "name",
    "scope",
    "status",
    "source",
    "match",
    "operation",
    "precedence",
    "optional",
    "examples",
    "counterexamples",
    "review",
    "notes"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "rule_id": {
      "type": "string",
      "pattern": "^EVS-[0-9]{3}$"
    },
    "name": {"type": "string", "minLength": 1},
    "scope": {"const": "external_vowel_sandhi"},
    "status": {
      "enum": [
        "draft",
        "self_checked",
        "expert_reviewed"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sutra_ids",
        "text_iast",
        "text_devanagari",
        "interpretation",
        "url",
        "commit",
        "license"
      ],
      "properties": {
        "sutra_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[1-8]\\.[1-4]\\.[0-9]+$"
          }
        },
        "text_iast": {
          "type": "string",
          "minLength": 1
        },
        "text_devanagari": {"type": "string"},
        "interpretation": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "commit": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "left_suffixes",
        "right_prefixes",
        "required_tags",
        "forbidden_tags"
      ],
      "properties": {
        "left_suffixes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "right_prefixes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "required_tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "forbidden_tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "left", "emit", "right"],
      "properties": {
        "kind": {"const": "rewrite"},
        "left": {
          "enum": ["drop_match", "keep_match"]
        },
        "emit": {"type": "string"},
        "right": {
          "enum": ["drop_match", "keep_match"]
        }
      }
    },
    "precedence": {
      "type": "integer",
      "minimum": 0
    },
    "optional": {"type": "boolean"},
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "left",
          "right",
          "surface",
          "tags",
          "source",
          "notes"
        ],
        "properties": {
          "left": {
            "type": "string",
            "minLength": 1
          },
          "right": {
            "type": "string",
            "minLength": 1
          },
          "surface": {
            "type": "string",
            "minLength": 1
          },
          "tags": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "notes": {"type": "string"}
        }
      }
    },
    "counterexamples": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["left", "right", "reason"],
        "properties": {
          "left": {
            "type": "string",
            "minLength": 1
          },
          "right": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "author",
        "reviewer",
        "reviewed_at"
      ],
      "properties": {
        "author": {
          "type": "string",
          "minLength": 1
        },
        "reviewer": {"type": "string"},
        "reviewed_at": {"type": "string"}
      }
    },
    "notes": {"type": "string"}
  }
}
